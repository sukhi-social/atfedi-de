---
import { locales, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Phrase from '../../components/Phrase.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<Base lang={lang} title="atfedi.de" description={t('home.hug')}>
  <div class="wrap">
    <section class="welcome">
      <svg class="buddy" viewBox="0 0 200 180" role="img" aria-label={t('home.mascot')}>
        <g class="buddy-tail">
          <path d="M140 150 C172 150 182 122 170 100" />
        </g>
        <ellipse class="fill" cx="100" cy="142" rx="50" ry="36" />
        <path d="M54 132 C24 128 14 100 24 76" />
        <path d="M146 132 C176 128 186 100 176 76" />
        <path class="fill" d="M66 56 L62 20 L92 40 Z" />
        <path class="fill" d="M134 56 L138 20 L108 40 Z" />
        <circle class="fill" cx="100" cy="82" r="42" />
        <path d="M80 80 q7 -8 14 0" />
        <path d="M106 80 q7 -8 14 0" />
        <path d="M93 96 q7 7 14 0" />
        <circle class="cheek" cx="76" cy="94" r="5" />
        <circle class="cheek" cx="124" cy="94" r="5" />
      </svg>
      <div class="welcome-text stack">
        <h1><Phrase text={t('home.hello')} lang={lang} /></h1>
        <p class="hug"><Phrase text={t('home.hug')} lang={lang} /></p>
        <p class="tagline"><Phrase text={t('home.hugSmall')} lang={lang} /></p>
      </div>
    </section>

    <section class="section stack">
      <h2 class="section-title">{t('basics.heading')}</h2>
      <p class="note"><Phrase text={t('basics.lead')} lang={lang} /></p>
      <!-- filled per request from atfedi-content (worker/content/pages.js) -->
      <div class="doors" data-basics></div>
    </section>

    <section class="prose stack">
      <h2 class="section-title">{t('intro.heading')}</h2>
      <p><Phrase text={t('intro.body')} lang={lang} /></p>
    </section>

    <section class="section stack">
      <p class="note">
        <Phrase text={t('home.platforms')} lang={lang} />
        <a href="https://joinfediverse.kr">joinfediverse.kr</a>
      </p>
      <p class="note">
        <Phrase text={t('home.catalog')} lang={lang} />
        <a href="https://fedidb.org">FediDB</a>
      </p>
      <p class="note">
        {t('home.tools')}
        <a href="/use/">{t('lane.use.name')}</a>
        · <a href="/build/">{t('lane.build.name')}</a>
      </p>
    </section>
  </div>
</Base>
