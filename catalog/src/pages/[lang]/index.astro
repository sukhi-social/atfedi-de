---
import { locales, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Phrase from '../../components/Phrase.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<Base lang={lang} title="atfedi.de" description={t('home.hug')}>
  <div class="wrap">
    <section class="welcome">
      <div class="welcome-text stack">
        <h1 data-home-hello><Phrase text={t('home.hello')} lang={lang} /></h1>
        <p class="hug" data-home-hug><Phrase text={t('home.hug')} lang={lang} /></p>
        <p class="tagline" data-home-small><Phrase text={t('home.hugSmall')} lang={lang} /></p>
      </div>
    </section>

    <section class="section stack">
      <h2 class="section-title">{t('basics.heading')}</h2>
      <p class="note"><Phrase text={t('basics.lead')} lang={lang} /></p>
      <!-- filled per request from atfedi-content (worker/content/pages.js) -->
      <div class="doors" data-basics></div>
    </section>

    <section class="section prose stack">
      <h2 class="section-title" data-home-intro-heading>{t('intro.heading')}</h2>
      <p data-home-intro><Phrase text={t('intro.body')} lang={lang} /></p>
    </section>

    <section class="section stack">
      <p class="note">
        <Phrase text={t('home.platforms')} lang={lang} />
        <a href="https://joinfediverse.kr">joinfediverse.kr</a>
      </p>
      <p class="note">
        <Phrase text={t('home.catalog')} lang={lang} />
        <a href="https://fedidb.org">FediDB</a>
      </p>
      <p class="note">
        {t('home.tools')}
        <a href="/use/">{t('lane.use.name')}</a>
        · <a href="/build/">{t('lane.build.name')}</a>
      </p>
    </section>

    <!-- who wrote the greeting, and the way in to rewrite it: filled by the Worker -->
    <div data-home-credits></div>
  </div>
</Base>
