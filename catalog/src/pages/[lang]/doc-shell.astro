---
import { locales, type Locale } from '../../i18n/ui';
import DocShell from '../../components/DocShell.astro';

// The shell for the basics (/basics/<slug>/) — see components/DocShell.
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
---

<DocShell lang={Astro.params.lang as Locale} />
